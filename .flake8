[flake8]
# Project style: 79-char lines (matches Black config in CLAUDE.md).
max-line-length = 79

# Vendored Thorlabs wrapper — not our code, ships with the OPM SDK.
extend-exclude =
    monet/TLPM.py

per-file-ignores =
    # dashboard.py embeds an HTML/CSS/JS page as a Python string; those
    # template lines cannot be wrapped at 79 chars without breaking markup.
    monet/dashboard.py: E501
